# Copy to backend/.env. Never put keys in the extension.

# Provider key for whichever LiteLLM model you choose (one is enough).
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# Avatar Talk uses a continuous Gemini Live audio session.
# SCROLLMATE_TALK_LIVE_MODEL=gemini-3.8-live
# SCROLLMATE_TALK_VOICE=Leda
# Optional overrides for the legacy HTTP /scrollmate/talk endpoint:
# SCROLLMATE_TALK_MODEL=gemini-flash-lite-latest
# SCROLLMATE_TALK_VOICE_MODEL=gemini-2.5-flash-preview-tts

# Any LiteLLM model string. The vision model must accept images.
SCROLLMATE_VISION_MODEL=openai/gpt-5.6-terra
SCROLLMATE_TEXT_MODEL=openai/gpt-5.6-terra
# Primary: OpenAI gpt-5.6-terra (~2.4 s vision, ~1.2 s reactions). Fallback: Groq Qwen, reasoning off.
SCROLLMATE_TEXT_FALLBACK_MODEL=groq/openai/gpt-oss-20b
SCROLLMATE_VISION_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
# OpenAI gpt-5/gpt-6 hidden reasoning: none = fastest, low = a bit smarter and slower
SCROLLMATE_OPENAI_REASONING=none
# Groq: qwen/qwen3.8-27b is the only Groq model with vision (8k tokens/min, 1k req/day per model).
# Other tested OpenAI options: openai/gpt-5.4-mini, openai/gpt-4.1-mini, openai/gpt-6-luna

SCROLLMATE_LLM_TIMEOUT=15

# 1 = no LLM calls, heuristic text-only answers (auto-on when no key is set)
SCROLLMATE_MOCK=0

# Restrict CORS to your unpacked extension's origin (copy the ID from chrome://extensions)
# SCROLLMATE_EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop

SCROLLMATE_RATE_LIMIT_PER_MIN=40

# Live feed on http://localhost:8000/ui shows the frame strip the AI saw (RAM only, never on disk)
SCROLLMATE_DEV_FEED_IMAGES=0

# Frames analysed per Short: auto (<=15s -> 4, <=30s -> 6, longer -> 8) or a number 1-12. Also switchable in /ui.
SCROLLMATE_FRAMES=auto
