{
  "name": "scrollmate-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --mode content && vite build --mode background && vite build --mode stage && npm run build:face-lib",
    "typecheck": "tsc --noEmit",
    "test:comments": "tsx --test tests/comments.test.ts",
    "test:comments:browser": "node scripts/test-comments-browser.mjs",
    "test:menu": "tsx --test tests/settings.test.ts",
    "test:talk": "tsx --test tests/talk.test.ts tests/talk-background.test.ts tests/voiceWorklets.test.ts tests/speech.test.ts",
    "test:talk:media": "node scripts/test-face-pipeline.mjs --talk",
    "test:menu:browser": "node scripts/test-menu-browser.mjs",
    "eval": "tsx ../eval/timing_eval.ts",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "test:roam": "tsx --test tests/roam.test.ts",
    "test:roam:browser": "node scripts/test-comments-browser.mjs tests/roam.browser.ts 110000",
    "test:power:browser": "node scripts/test-comments-browser.mjs tests/power.browser.ts 20000",
    "test:comments-open:browser": "node scripts/test-comments-browser.mjs tests/commentsOpen.browser.ts 20000",
    "test:avatar-motion:browser": "node scripts/test-comments-browser.mjs tests/avatarMotion.browser.ts 40000",
    "test:face": "tsx --test tests/faceSignals.test.ts tests/feelings.test.ts",
    "build:face-lib": "esbuild src/shared/faceSignals.ts --format=esm --outfile=../backend/app/static/faceSignals.js --log-level=warning",
    "test:stress:browser": "node scripts/test-comments-browser.mjs tests/stress.browser.ts 150000",
    "test:tabs": "tsx --test tests/background-tabs.test.ts",
    "test:timing": "tsx --test tests/timing.test.ts",
    "test:face:browser": "node scripts/test-comments-browser.mjs tests/faceMirror.browser.ts 60000"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "motion": "12.23.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
