{
  "name": "scrollmate-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --mode content && vite build --mode background && vite build --mode stage",
    "typecheck": "tsc --noEmit",
    "test:comments": "tsx --test tests/comments.test.ts",
    "test:comments:browser": "node scripts/test-comments-browser.mjs",
    "eval": "tsx ../eval/timing_eval.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
